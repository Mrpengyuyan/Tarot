# =========================
# Backend (FastAPI)
# =========================
PROJECT_NAME=Tarot Game API
PROJECT_VERSION=1.0.0
API_V1_STR=/api/v1

DATABASE_URL=sqlite:///./tarot_game.db

SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REQUIRE_STRONG_SECRET=true
AUTH_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
CSRF_PROTECTION_ENABLED=true
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=65
DEEPSEEK_CHAT_ENDPOINT=chat/completions
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
DEEPSEEK_TRUST_ENV_PROXY=false
DEEPSEEK_ENABLE_REASONER_FALLBACK=true
DEEPSEEK_REASONER_TRIGGER_CHARS=180
DEEPSEEK_REASONER_TRIGGER_KEYWORDS=why,how,analyze,strategy,complex,tradeoff,risk,plan
DEEPSEEK_FORCE_JSON_OUTPUT=true

# AI retry and budget guard
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_MS=800
AI_RETRY_BACKOFF_FACTOR=2.0
AI_RETRY_MAX_BACKOFF_MS=5000
AI_RETRY_ON_TIMEOUT=true
AI_RETRY_ON_429=true
AI_RETRY_ON_5XX=true
AI_MAX_OUTPUT_TOKENS=900

AI_BUDGET_GUARD_ENABLED=true
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=120
AI_REQUEST_SOFT_CAP_USD=0.0035
AI_REASONER_MAX_PERCENT=0.20
AI_REASONER_RATIO_WARMUP_CALLS=20
AI_DISABLE_REASONER_WHEN_BUDGET_HIGH=true
AI_BUDGET_ALERT_THRESHOLD=0.85

# Cost accounting table (USD per 1M tokens)
AI_COST_CHAT_INPUT_PER_M=0.28
AI_COST_CHAT_OUTPUT_PER_M=0.42
AI_COST_REASONER_INPUT_PER_M=0.55
AI_COST_REASONER_OUTPUT_PER_M=2.19

# Legacy compatibility fallback (optional)
COZE_API_KEY=
COZE_BOT_ID=

DEBUG=true
METRICS_EXPECTED_TAROT_CARDS=78
METRICS_EXPECTED_SPREADS=6
AUTO_CREATE_TABLES_ON_STARTUP=false
AUTO_BOOTSTRAP_REFERENCE_DATA_ON_STARTUP=false

# =========================
# Frontend (React)
# =========================
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1
REACT_APP_NAME=Tarot Game
REACT_APP_VERSION=1.0.0
REACT_APP_ENABLE_3D=true
REACT_APP_ENABLE_ANIMATIONS=true
REACT_APP_DEBUG_MODE=false
