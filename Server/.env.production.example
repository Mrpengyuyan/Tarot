# ============================================================
# Tarot Game API — Production Template (Low-Budget Small Circle)
# Copy to Server/.env on your server and replace all placeholders.
# NEVER commit Server/.env to git.
# ============================================================

PROJECT_NAME=Tarot Game API
PROJECT_VERSION=1.0.0
API_V1_STR=/api/v1

ENVIRONMENT=production
DEBUG=false

# Persist SQLite inside a mounted volume (or switch to PostgreSQL URL)
DATABASE_URL=sqlite:////data/tarot_game.db

# Generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REQUIRE_STRONG_SECRET=true

# HTTPS cookie and CSRF hardening
AUTH_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
CSRF_PROTECTION_ENABLED=true
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Replace with your actual HTTPS domain (no localhost, no wildcard '*')
CORS_ORIGINS=https://tarot.example.com
CORS_ALLOW_CREDENTIALS=true

# Reverse proxy IPs/CIDRs trusted to supply X-Forwarded-For (Caddy / Nginx / Docker bridge)
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12

# DeepSeek API (replace with your key on the server only)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=65
DEEPSEEK_CHAT_ENDPOINT=chat/completions
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
DEEPSEEK_TRUST_ENV_PROXY=false
# Keep reasoner fallback off for low-cost small-circle playtesting
DEEPSEEK_ENABLE_REASONER_FALLBACK=false
DEEPSEEK_FORCE_JSON_OUTPUT=true
ALLOW_MOCK_AI_FALLBACK=false

# Conservative budget guard & per-player rate limits (self-funded API protection)
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=800
AI_BUDGET_GUARD_ENABLED=true
AI_DAILY_BUDGET_USD=1.0
AI_MONTHLY_BUDGET_USD=10.0
AI_REQUEST_SOFT_CAP_USD=0.0035
AI_REASONER_MAX_PERCENT=0.0
AI_DISABLE_REASONER_WHEN_BUDGET_HIGH=true
AI_BUDGET_ALERT_THRESHOLD=0.85

# Cost accounting table (USD per 1M tokens)
AI_COST_CHAT_INPUT_PER_M=0.28
AI_COST_CHAT_OUTPUT_PER_M=0.42
AI_COST_REASONER_INPUT_PER_M=0.55
AI_COST_REASONER_OUTPUT_PER_M=2.19

# Per-player daily & hourly caps (players can switch to offline mode anytime)
GUEST_DAILY_READING_LIMIT=2
GUEST_SESSIONS_PER_HOUR=5
USER_DAILY_READING_LIMIT=2
AI_INTERPRETATION_STALE_SECONDS=300
AI_INTERPRETATION_MAX_ATTEMPTS=3

# Startup safety (initialize DB via alembic + init_tarot_data before serving traffic)
HEALTH_ADMIN_ONLY=false
AUTO_CREATE_TABLES_ON_STARTUP=false
AUTO_BOOTSTRAP_REFERENCE_DATA_ON_STARTUP=false
AUTO_REPAIR_PREDICTION_QUESTIONS_ON_STARTUP=false
METRICS_EXPECTED_TAROT_CARDS=78
METRICS_EXPECTED_SPREADS=6
